pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonarcloud-token')
        SCANNER_HOME = tool 'sonar_scanner'
    }

    stages {

        stage('Clone') {
            steps {
                git branch: 'development', url: 'https://github.com/ShaliniNettam/Farmers.git'
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                sh """
                ${SCANNER_HOME}/bin/sonar-scanner \
                  -Dsonar.organization=shalininettam \
                  -Dsonar.projectKey=ShaliniNettam_Farmers \
                  -Dsonar.sources=farm \
                  -Dsonar.exclusions=farm/frontend/**,farm/backend/**,**/node_modules/**,**/dist/**,**/*.yaml,**/*.yml \
                  -Dsonar.host.url=https://sonarcloud.io \
                  -Dsonar.login=${SONAR_TOKEN}
                """
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                cd farm/backend
                docker build -t farm-backend:latest .

                cd ../frontend
                docker build -t farm-frontend:latest .
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                cd farm
                docker-compose down
                docker-compose up -d --build
                '''
            }
        }
    }

    post {
        always {
            echo "Pipeline Completed!"
        }
    }
}
